# SentinalScan Backend Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All backend variables use the SENTINAL_ prefix because app.core.config sets
# env_prefix="SENTINAL_".

# Required API key for REST and WebSocket authentication.
# Must be at least 32 characters and must not be a known default.
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SENTINAL_API_KEY=generate_a_64_character_hex_key_here

# Secret key reserved for future signing/session features.
# Generate separately from SENTINAL_API_KEY.
SENTINAL_SECRET_KEY=generate_a_64_character_hex_secret_here

# Logging
SENTINAL_LOG_LEVEL=INFO
SENTINAL_LOG_FORMAT=json

# CORS origins allowed to call the API.
SENTINAL_BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Server
SENTINAL_HOST=127.0.0.1
SENTINAL_PORT=8000

# Scanner defaults
SENTINAL_DEFAULT_MAX_PAGES=50
SENTINAL_DEFAULT_WORKERS=5
SENTINAL_DEFAULT_TIMEOUT=15
SENTINAL_USER_AGENT=SentinalScan/2.2.0
