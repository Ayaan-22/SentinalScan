# SentinalScan Frontend Environment Variables
#
# Vite exposes VITE_* values to browser JavaScript after build. Treat these as
# public configuration, not secrets. Do not put private credentials here.

# Backend API URL. This must include the /api/v1 path prefix.
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket server base URL. The app appends /ws/logs/{scan_id}.
VITE_WS_URL=ws://localhost:8000

# Optional convenience for local demos only. Frontend API keys are public after
# build, so the app also provides a session-only API key field in the UI.
# VITE_API_KEY=
